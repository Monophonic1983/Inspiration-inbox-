    "Off by default. When on, the text of each thought is sent to %@ to structure it. Audio is never sent.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. When on, the text of each thought is sent to %@ to structure it. Audio is never sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。开启后，每条想法的文字会发送给 %@ 进行整理。录音绝不会上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設關閉。開啟後，每條想法的文字會傳送給 %@ 進行整理。錄音絕不會上傳。"
          }
        }
      }
    },
